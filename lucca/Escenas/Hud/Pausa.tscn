anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -190.0
offset_top = -175.0
offset_right = 190.0
offset_bottom = 175.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="Margin" type="MarginContainer" parent="Overlay/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 30
theme_override_constants/margin_top = 28
theme_override_constants/margin_right = 30
theme_override_constants/margin_bottom = 28

[node name="Content" type="VBoxContainer" parent="Overlay/Panel/Margin"]
